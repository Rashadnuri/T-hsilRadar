# ═══════════════════════════════════════════════════════════════════════════════════════════
# TəhsilRadar — environment variables.   Copy to .env.local and fill in.
# NEVER commit .env.local (it is git-ignored). This file holds PLACEHOLDERS only.
#
# Where each variable goes
#   local development .... .env.local
#   Vercel ................ Project → Settings → Environment Variables (pick the right scope!)
#   GitHub Actions ........ not needed: CI uses throw-away values (see .github/workflows/ci.yml)
#
# Check a production environment without printing any value:   npm run preflight -- <env file>
# Full walkthrough: DEPLOYMENT.md
# ═══════════════════════════════════════════════════════════════════════════════════════════

# ── 1. Public site address ─────────────────────────────────────────────────────────────────
# Origin only: scheme + host, no path, no trailing slash. Used for canonical URLs, hreflang, the
# sitemap, Open Graph tags and the links inside sign-up / password-reset e-mails.
#   Local ........ http://localhost:3000
#   Vercel ....... set it for the PRODUCTION scope only, e.g. https://tahsilradar.az
#                  Leave it UNSET for Preview: previews then use their own *.vercel.app address,
#                  are never indexed, and their e-mail links stay on the preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 2. Supabase (database + authentication) ────────────────────────────────────────────────
# Dashboard → Project Settings → API (local stack: `supabase start` prints both values).
# Set BOTH or NEITHER. These two are public by design (they end up in the browser); they are safe
# only because row level security lets the anon role read nothing but published, verified records.
# Use the "anon" / "publishable" key here — NEVER the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service-role key BYPASSES row level security. The application does not use it at all:
# do NOT set it in Vercel. (A helper exists in src/lib/supabase/admin.ts for future server-only jobs.)
# SUPABASE_SERVICE_ROLE_KEY=

# ── 3. Demo content ────────────────────────────────────────────────────────────────────────
# Fictional, labelled records for design work and demos. Never indexed.
#   Real production (Supabase configured) ... false. Unset is also treated as false there.
#   Demo-only deployment (NO Supabase, e.g. a bare Vercel deploy to look at the interface) ... leave
#       unset: the built-in demo cards are then shown automatically, labelled "Demo".
#   Preview / staging with a seeded Supabase project ... true to show the seeded demo rows.
#   Local dev .... true (default when unset)
# An explicit true / false always wins; an unclear value (e.g. "yes") fails closed in production.
SHOW_DEMO_CONTENT=true

# ── 3b. Contact address (recommended) ─────────────────────────────────────────────────────
# A real, monitored mailbox. With it the Contact page offers topic buttons that open the visitor's e-mail
# app with the subject filled in; without it the page keeps its honest "form not active yet" notice.
# It is shown publicly (so it is not a secret) and applied at BUILD time: redeploy after changing it.
# NEXT_PUBLIC_CONTACT_EMAIL=info@your-domain.example

# ── 4. AI explanations (optional) ──────────────────────────────────────────────────────────
# Rule-based matching needs NOTHING here and always works. Without a key, or with AI_ENABLED=false,
# the AI panel simply says it is unavailable.
# SERVER-ONLY secret: never prefix with NEXT_PUBLIC_. Set a spend limit at the provider as well.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# Kill switch: "false" turns AI off at once even when a key is present.
# AI_ENABLED=true
# Model; a smaller one is cheaper for short explanations (default claude-opus-5-5).
# AI_MODEL=claude-opus-5-5
# Limits PER SERVER INSTANCE (not shared between serverless instances — see KNOWN_LIMITATIONS.md):
# requests per user per minute / per day, and all users per day.
# AI_RATE_PER_MINUTE=5
# AI_RATE_PER_DAY=40
# AI_GLOBAL_PER_DAY=2000
# AI_MAX_OUTPUT_TOKENS=1500
# AI_TIMEOUT_MS=30000

# ── 5. Development only — must NOT exist in production ─────────────────────────────────────
# In-memory stand-ins so the app can run without Supabase / an AI key. They refuse to load when
# NODE_ENV=production, and `npm run preflight` reports them as errors.
# FAKE_AUTH=1                              # in-memory sign-up / sign-in (requires Supabase vars to be unset)
# FAKE_AUTH_CONFIRM_EMAIL=1                # fake e-mail confirmation step
# FAKE_AUTH_MAILBOX_FILE=/tmp/fake-mailbox.jsonl
# FAKE_ADMIN_EMAILS=admin@example.com      # which fake accounts are admins (real admins are granted in SQL)
# AI_FAKE=1                                # deterministic stand-in for the model

# ── 6. Database tests (optional) ───────────────────────────────────────────────────────────
# A superuser connection to any PostgreSQL 15+ / local Supabase DB. The suites create and drop their
# own throw-away databases (tahsil_test_*). Without it the database suites are SKIPPED.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Set by Vercel itself (do not add these) ────────────────────────────────────────────────
# VERCEL_ENV (production | preview | development), VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL.
# The app reads them to decide the site address when NEXT_PUBLIC_SITE_URL is unset, and to keep
# preview deployments out of search engines.
